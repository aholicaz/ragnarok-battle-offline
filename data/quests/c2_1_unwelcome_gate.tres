[resource]
script = ExtResource("1_quest")
id = &"c2_1_unwelcome_gate"
title = "C2-1 ประตูที่ไม่ต้อนรับ"
description = "ชาวนิดาเวลลิร์ไม่ต้อนรับคนแปลกหน้า ไปแนะนำตัวกับช่างเอกดวาลินและบรอกก์"
giver_name = "นายหน้าเฮลกา"
dialog_offer = "มนุษย์...? นานแล้วนะที่ไม่มีมนุษย์เดินผ่านประตูนั้นเข้ามา ถ้าอยากให้ใครในเมืองนี้คุยด้วย ไปให้ช่างเอกดวาลินกับบรอกก์เห็นหน้าก่อนเถอะ"
dialog_progress = "ดวาลินอยู่หน้าเตาตีเหล็ก ส่วนบรอกก์... แกไม่ค่อยอยากคุยกับใครหรอก"
dialog_complete = "อย่างน้อยเจ้าก็กล้าดี... เมืองนี้ไม่ต้อนรับใคร แต่ก็ไม่ไล่ใครเหมือนกัน อยู่ไปเถอะ แค่อย่าถามอะไรมากนัก"
objectives = Array[ExtResource("2_obj")]([SubResource("Obj_0"), SubResource("Obj_1")])
kill_monster_id = &""
required_level = 18
required_flag = &"chapter2_open"
set_flag_on_complete = &"nidavellir_intro"
reward_zeny = 800
reward_exp = 3000
