giver_name = "นายหน้าเฮลกา"
dialog_offer = "ในเมืองนี้ไม่มีอะไรฟรี อยากให้ข้าขายของราคาคนใน ก็เอาของจากทางเหล็กมาแลกสิ — เปลือกด้วงเหล็กกับก้อนดินอัดของพวกพิตแมน"
dialog_progress = "เปลือกเหล็กห้าชิ้น ดินอัดห้าก้อน จากพวกมอนบนทางเหล็กนั่นแหละ"
dialog_complete = "ฮึ... ใช้ได้นี่ ตกลงตามนั้น เจ้าซื้อของข้าราคาคนในได้แล้ว"
