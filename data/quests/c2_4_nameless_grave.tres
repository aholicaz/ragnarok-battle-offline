[resource]
script = ExtResource("1_quest")
id = &"c2_4_nameless_grave"
title = "C2-4 หลุมศพที่ไม่มีชื่อ"
description = "มีหลุมศพเก่าท้ายเมืองที่ชื่อบนป้ายถูกสกัดออก ไปดูให้เห็นกับตา"
giver_name = "ช่างตีเหล็กฮันส์"
dialog_offer = "บรอกก์เผลอพูดถึง «หลุมท้ายเมือง» แล้วก็หุบปากทันที... ไปดูหลุมศพนั้นให้ข้าที ข้าไม่กล้าไปเอง"
dialog_progress = "หลุมศพอยู่ท้ายเมืองนิดาเวลลิร์"
dialog_complete = "ชื่อบนป้ายถูกสกัดออก... เหมือนศิลาสลักที่บ้านเราเลย ใครกัน... ใครกันที่ไล่ลบชื่อคนตายไปทั่วทุกโลกแบบนี้"
objectives = Array[ExtResource("2_obj")]([SubResource("Obj_0")])
kill_monster_id = &""
required_level = 21
required_quests = Array[StringName]([&"c2_3_forbidden_name"])
