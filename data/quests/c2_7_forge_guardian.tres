[resource]
script = ExtResource("1_quest")
id = &"c2_7_forge_guardian"
title = "C2-7 ผู้พิทักษ์เตาหลอม"
description = "ล้มผู้พิทักษ์เตาหลอม เพื่อเปิดทางไปยังกำแพงด้านในสุด"
giver_name = "ช่างเอกดวาลิน"
dialog_offer = "ผู้พิทักษ์เตาหลอมถูกสร้างมาเฝ้า «บางสิ่ง» บนกำแพงในสุด... ล้มมันซะ แล้วดูให้เห็นกับตาว่ามันเฝ้าอะไรไว้"
dialog_progress = "ผู้พิทักษ์อยู่ในสุดของเตาหลอมร้าง ระวังค้อนของมัน"
dialog_complete = "...เจ้าล้มมันได้จริง ๆ สี่สิบปีที่ไม่มีใครทำได้ ตอนนี้ไม่มีอะไรบังกำแพงด้านในแล้ว... ไปดูเถอะ"
