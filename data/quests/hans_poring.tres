[resource]
script = ExtResource("1_quest")
id = &"hans_poring"
title = "งานแรก — โพริงล้นทุ่ง"
description = "โพริงล้นออกมาจากป่าจนฮันส์ออกไปหาแร่ไม่ได้ ช่วยเคลียร์ทุ่งวิหารให้หน่อย"
giver_name = "ช่างตีเหล็กฮันส์"
dialog_offer = "เจ้าโพริงพวกนั้นเต็มทุ่งไปหมด ข้าออกไปหาแร่ไม่ได้เลย ช่วยล่าให้หน่อยได้ไหม"
dialog_progress = "ยังไม่ครบร้อยตัวนะ อดทนอีกนิด"
dialog_complete = "โอ้ เก่งมาก! นี่ฟราคอนที่ข้าเก็บไว้ เอาไปตีบวกอาวุธได้เลย"
kill_monster_id = &"poring"
kill_count = 50
required_quests = Array[StringName]([&"m2_oath"])
