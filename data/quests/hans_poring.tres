[ext_resource type="Script" path="res://scripts/resources/quest_data.gd" id="1_quest"]

[resource]
script = ExtResource("1_quest")
id = &"hans_poring"
title = "งานแรก — โพริงล้นทุ่ง"
description = "โพริงล้นออกมาจากป่าจนฮันส์ออกไปหาแร่ไม่ได้ ช่วยเคลียร์ทุ่งวิหารให้หน่อย"
