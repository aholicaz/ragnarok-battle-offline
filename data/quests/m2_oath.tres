[gd_resource type="Resource" script_class="QuestData" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/resources/quest_data.gd" id="1_quest"]
[ext_resource type="Script" path="res://scripts/resources/objective_data.gd" id="2_obj"]

[sub_resource type="Resource" id="Obj_0"]
script = ExtResource("2_obj")
kind = 2
target = &"ศิลาสลักแห่งธอร์"
count = 1
text = "ทำพิธีที่ศิลาสลักแห่งธอร์"

[resource]
script = ExtResource("1_quest")
id = &"m2_oath"
title = "M2 คำสาบานใต้ค้อน"
description = "ทำพิธีต่อหน้าศิลาสลักแห่งธอร์ แล้วกลับมากล่าวคำสาบานกับวาลเดอร์"
giver_name = "นักบวชสูงสุดวาลเดอร์"
dialog_offer = "นักผจญภัยทุกคนต้องผ่านพิธีใต้ค้อน จงไปแตะศิลาสลักแห่งธอร์กลางเมือง แล้วกลับมาหาข้า"
dialog_progress = "ศิลาสลักอยู่กลางเมือง ใต้ตราค้อนใหญ่นั่นแหละ"
dialog_complete = "บัดนี้เจ้ายืนอยู่ใต้แสงของธอร์แล้ว เหลือเพียงขั้นสุดท้าย..."
objectives = Array[ExtResource("2_obj")]([SubResource("Obj_0")])
kill_monster_id = &""
required_level = 2
required_quests = Array[StringName]([&"m1_adventurer_badge"])
choice_prompt = "จงกล่าวตามข้า — «ข้าขอสาบานต่อธอร์ จะรับใช้แสงแห่งสายฟ้าตราบชีวิตจะหาไม่»"
choice_options = Array[String](["ข้าขอสาบาน", "...(ยืนเงียบ)"])
choice_flags = Array[StringName]([&"swore_oath", &"stayed_silent"])
reward_zeny = 0
reward_exp = 250
