[resource]
script = ExtResource("1_quest")
id = &"m7_silent_forest"
title = "M7 ป่าที่เงียบเกินไป"
description = "ป่าสนธยาเงียบผิดปกติ ไปตรวจดูว่าเกิดอะไรขึ้น"
giver_name = "ทหารยามเอริค"
dialog_offer = "พวกลาดตระเวนบอกว่าป่าสนธยาช่วงนี้เงียบผิดปกติ... เสียงนกเสียงแมลงหายไปเป็นหย่อม ๆ ไปตรวจดูที ถ้าเจออะไรแปลก ๆ ให้ดูให้ละเอียด"
dialog_progress = "ในป่าสนธยา ลองเดินลึกเข้าไปหน่อย มีบางอย่างให้ตรวจแน่ ๆ"
dialog_complete = "ตายโดยไม่มีบาดแผล...? ...อย่าเพิ่งเล่าเรื่องนี้ให้ชาวเมืองฟัง เดี๋ยวคนแตกตื่น ข้าจะรายงานท่านวาลเดอร์เอง"
objectives = Array[ExtResource("2_obj")]([SubResource("Obj_0"), SubResource("Obj_1")])
required_level = 7
required_quests = Array[StringName]([&"m6_ceremony"])
reward_zeny = 400
reward_exp = 1200
