[resource]
script = ExtResource("1_quest")
id = &"m9_missing_hunter"
title = "M9 คนที่ไม่กลับมา"
description = "พ่อของอิงกริดหายไปในป่าเงาลึก เคลียร์ฝูงหมาป่าเพื่อเปิดทางตามหา"
giver_name = "อิงกริด"
dialog_offer = "พ่อข้าเข้าป่าเงาลึกไปหลายวันแล้วยังไม่กลับ... แกไม่เคยหลงทางนะ ช่วยข้าที ฝูงหมาป่าแถวนั้นดุจนข้าเข้าไปเองไม่ได้"
dialog_progress = "หมาป่าในป่าเงาลึกยังเยอะอยู่ ระวังตัวด้วยนะ"
dialog_complete = "ยังไม่เจอตัวพ่อ... แต่ขอบคุณที่เปิดทางให้ ถ้าเจอข้าวของของพ่อ เอามาให้ข้าดูด้วยนะ"
objectives = Array[ExtResource("2_obj")]([SubResource("Obj_0"), SubResource("Obj_1")])
required_level = 10
required_quests = Array[StringName]([&"m8_burnt_bark"])
reward_zeny = 600
reward_exp = 2000
