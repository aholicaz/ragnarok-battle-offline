[node name="Guide" parent="NPCs" unique_id=1727980527 instance=ExtResource("npc")]
position = Vector2(-624, 590)
npc_name = "ทหารยามเอริค"
type = 0
dialog = "เด็กใหม่สินะ ข้าเอริค ยามประตูเมืองนี้

กด C ดูสเตตัส · I เปิดกระเป๋า · K เรียนสกิล · M ดูแผนที่
J หรือคลิกซ้าย = ฟันดาบ · W หรือ Space = พุ่งหลบ อย่าอาย ข้าเองก็หลบทุกครั้ง

...แล้วก็อย่าเข้าป่าลึกตอนค่ำนะ ผู้กองสั่งห้ามไว้
ไม่ได้บอกเหตุผลด้วย"
quest_ids = Array[StringName]([&"m1_adventurer_badge", &"m7_silent_forest", &"m13_thunder_scar"])

[node name="HighPriest" parent="NPCs" unique_id=1318346366 instance=ExtResource("npc")]
